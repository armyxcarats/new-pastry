# Copy these settings into backend/config/.env and fill in your provider's values.
# Never commit backend/config/.env or share the SMTP password.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_EMAIL=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Pastry Shop

# Firebase Console > Project settings > Service accounts > Generate new private key.
# Keep the private key in backend/config/.env only; represent newlines as \n.
FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-private-key\n-----END PRIVATE KEY-----\n"

# For Gmail, use smtp.gmail.com with port 465 and a Google App Password
# (not your regular Gmail password). A Google App Password requires 2-Step
# Verification to be enabled on the Google account.
